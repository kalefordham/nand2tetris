// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[0..2], a=regload1, b=regload2, c=regload3, d=regload4, e=regload5, f=regload6, g=regload7, h=regload8);
    RAM64(in=in, load=regload1, address=address[3..8], out=regout1);
    RAM64(in=in, load=regload2, address=address[3..8], out=regout2);
    RAM64(in=in, load=regload3, address=address[3..8], out=regout3);
    RAM64(in=in, load=regload4, address=address[3..8], out=regout4);
    RAM64(in=in, load=regload5, address=address[3..8], out=regout5);
    RAM64(in=in, load=regload6, address=address[3..8], out=regout6);
    RAM64(in=in, load=regload7, address=address[3..8], out=regout7);
    RAM64(in=in, load=regload8, address=address[3..8], out=regout8);
    Mux8Way16(a=regout1, b=regout2, c=regout3, d=regout4, e=regout5, f=regout6, g=regout7, h=regout8, sel=address[0..2], out=out);
}
